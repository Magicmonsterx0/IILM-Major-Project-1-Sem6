:root {
}

.buttonstyle {
    margin-top: 43px;
    margin-right: 44px;
    margin-left: 44px;
    margin-bottom: 43px;
    font-size: 37px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    width: 618px;
    height: 145px;
    min-width: 46px;
}

.buttonstyle:hover {
    scale: 1.03 1.03 1.03;
    transition-duration: 0.5s;
    background-color: rgb(0, 231, 249);
    background-image: url("project://database/Assets/Violet%20Theme%20Ui/Buttons/Misc/80x80%20Background.png?fileID=2800000&guid=a64f98d7a00501442ae40845562f1c20&type=3#80x80 Background");
    -unity-background-image-tint-color: rgb(79, 240, 251);
}
